{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vland.invalid/schemas/spawn-state.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "vland.spawn.state"
    },
    "schemaVersion": {
      "const": 4
    },
    "programFingerprint": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000000
    },
    "clock": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "seconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000000
        },
        "turns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000000
        }
      },
      "required": [
        "seconds",
        "turns"
      ]
    },
    "disabledSourceIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
        "not": {
          "enum": [
            "__proto__",
            "prototype",
            "constructor"
          ]
        }
      },
      "maxItems": 256,
      "uniqueItems": true
    },
    "entities": {
      "type": "array",
      "items": {
        "$ref": "emission.schema.json"
      },
      "maxItems": 12000
    },
    "records": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
        "not": {
          "enum": [
            "__proto__",
            "prototype",
            "constructor"
          ]
        }
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "created": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000
          },
          "attempt": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000
          },
          "activated": {
            "type": "boolean"
          },
          "nextAt": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 1000000000000
              },
              {
                "type": "null"
              }
            ]
          },
          "done": {
            "type": "boolean"
          },
          "rules": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
              "not": {
                "enum": [
                  "__proto__",
                  "prototype",
                  "constructor"
                ]
              }
            },
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "created": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000000
                },
                "target": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 5000
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "sequence": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000000000
                }
              },
              "required": [
                "created",
                "target",
                "sequence"
              ]
            }
          }
        },
        "required": [
          "created",
          "attempt",
          "activated",
          "nextAt",
          "done",
          "rules"
        ]
      }
    },
    "checksum": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    }
  },
  "required": [
    "schema",
    "schemaVersion",
    "programFingerprint",
    "revision",
    "clock",
    "disabledSourceIds",
    "entities",
    "records",
    "checksum"
  ]
}
