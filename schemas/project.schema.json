{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vland.invalid/schemas/project.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "vland.project"
    },
    "schemaVersion": {
      "const": 4
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "recipe": {
      "$ref": "recipe.schema.json"
    },
    "source": {
      "type": "object"
    },
    "catalog": {
      "$ref": "catalog.schema.json"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "source.schema.json"
      },
      "maxItems": 256
    },
    "transitions": {
      "type": "array",
      "items": {
        "$ref": "transition.schema.json"
      },
      "maxItems": 128
    },
    "edits": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "layerId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
                "not": {
                  "enum": [
                    "__proto__",
                    "prototype",
                    "constructor"
                  ]
                }
              },
              "x": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4095
              },
              "y": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4095
              },
              "surface": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "trait": {
                "enum": [
                  "normal",
                  "fertile",
                  "poisoned",
                  "frozen",
                  "burnt"
                ]
              }
            },
            "required": [
              "layerId",
              "x",
              "y",
              "surface",
              "trait"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "layerId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
                "not": {
                  "enum": [
                    "__proto__",
                    "prototype",
                    "constructor"
                  ]
                }
              },
              "x": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4095
              },
              "y": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4095
              },
              "field": {
                "enum": [
                  "biome",
                  "fertility",
                  "elevation",
                  "waterDepth",
                  "water"
                ]
              },
              "value": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                ]
              }
            },
            "required": [
              "layerId",
              "x",
              "y",
              "field",
              "value"
            ]
          }
        ]
      },
      "maxItems": 32000
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000000
    },
    "checksum": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    }
  },
  "required": [
    "schema",
    "schemaVersion",
    "version",
    "recipe",
    "source",
    "catalog",
    "sources",
    "edits",
    "revision",
    "checksum"
  ]
}
