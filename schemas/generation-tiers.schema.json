{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vland.invalid/schemas/generation-tiers.schema.json",
  "title": "VlandGenerator world-request v1",
  "type": "object",
  "properties": {
    "layers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 48,
            "pattern": "^(?!__proto__$|constructor$|prototype$)[a-zA-Z0-9_-]+$"
          },
          "elevation": {
            "type": "number",
            "minimum": -256,
            "maximum": 256
          },
          "headroom": {
            "type": "number",
            "minimum": 1,
            "maximum": 32
          },
          "request": {
            "anyOf": [
              {
                "$ref": "../engine/schemas/request.schema.json"
              },
              {
                "$ref": "../engine/schemas/recipe.schema.json"
              }
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "id"
        ]
      },
      "maxItems": 8,
      "minItems": 1
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 48,
            "pattern": "^(?!__proto__$|constructor$|prototype$)[a-zA-Z0-9_-]+$"
          },
          "from": {
            "type": "object",
            "properties": {
              "layerId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 48,
                "pattern": "^(?!__proto__$|constructor$|prototype$)[a-zA-Z0-9_-]+$"
              },
              "room": {
                "type": "string",
                "minLength": 1,
                "maxLength": 96
              }
            },
            "additionalProperties": false,
            "required": [
              "layerId"
            ]
          },
          "to": {
            "type": "object",
            "properties": {
              "layerId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 48,
                "pattern": "^(?!__proto__$|constructor$|prototype$)[a-zA-Z0-9_-]+$"
              },
              "room": {
                "type": "string",
                "minLength": 1,
                "maxLength": 96
              }
            },
            "additionalProperties": false,
            "required": [
              "layerId"
            ]
          },
          "kind": {
            "enum": [
              "stairs",
              "lift",
              "drop"
            ]
          },
          "direction": {
            "enum": [
              "both",
              "forward"
            ]
          },
          "footprint": {
            "type": "object",
            "properties": {
              "width": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3
              },
              "height": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3
              }
            },
            "additionalProperties": false,
            "required": [
              "width",
              "height"
            ]
          },
          "clearance": {
            "type": "number",
            "minimum": 1,
            "maximum": 8
          },
          "requirements": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32,
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "maxItems": 16,
            "minItems": 0
          },
          "travelCost": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000,
            "exclusiveMinimum": 0
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "from",
          "to"
        ]
      },
      "maxItems": 24,
      "minItems": 0
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 32,
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "maxItems": 16,
      "minItems": 0
    },
    "grants": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 48,
            "pattern": "^(?!__proto__$|constructor$|prototype$)[a-zA-Z0-9_-]+$"
          },
          "layerId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 48,
            "pattern": "^(?!__proto__$|constructor$|prototype$)[a-zA-Z0-9_-]+$"
          },
          "room": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96
          },
          "capability": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "pattern": "^[a-z][a-z0-9-]*$"
          }
        },
        "additionalProperties": false,
        "required": [
          "layerId",
          "capability"
        ]
      },
      "maxItems": 16,
      "minItems": 0
    },
    "entryLayerId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 48,
      "pattern": "^(?!__proto__$|constructor$|prototype$)[a-zA-Z0-9_-]+$"
    },
    "exitLayerId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 48,
      "pattern": "^(?!__proto__$|constructor$|prototype$)[a-zA-Z0-9_-]+$"
    },
    "autoTransports": {
      "$ref": "../engine/schemas/transport-settings.schema.json#/$defs/world"
    }
  },
  "additionalProperties": false,
  "required": [
    "layers"
  ]
}
