{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vland.invalid/schemas/raster.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "vland.raster"
    },
    "schemaVersion": {
      "const": 4
    },
    "colorMode": {
      "const": "RGBA8"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "layerId": {
            "type": "string"
          },
          "width": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16384
          },
          "height": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16384
          },
          "mime": {
            "const": "image/png"
          },
          "encoding": {
            "const": "base64"
          },
          "data": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "layerId",
          "width",
          "height",
          "mime",
          "encoding",
          "data"
        ]
      },
      "minItems": 1,
      "maxItems": 16
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "schema",
    "schemaVersion",
    "colorMode",
    "files",
    "note"
  ]
}
