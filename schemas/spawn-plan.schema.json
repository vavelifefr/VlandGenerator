{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vland.invalid/schemas/spawn-plan.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "vland.spawn.plan"
    },
    "schemaVersion": {
      "const": 4
    },
    "sceneFingerprint": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "stateChecksum": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "clock": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "seconds": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000000
            },
            "turns": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000000
            }
          },
          "required": [
            "seconds",
            "turns"
          ]
        },
        "phase": {
          "enum": [
            "day",
            "night"
          ]
        },
        "activeLayerIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
            "not": {
              "enum": [
                "__proto__",
                "prototype",
                "constructor"
              ]
            }
          },
          "maxItems": 256,
          "uniqueItems": true
        },
        "activeSourceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
            "not": {
              "enum": [
                "__proto__",
                "prototype",
                "constructor"
              ]
            }
          },
          "maxItems": 256,
          "uniqueItems": true
        },
        "enteredSourceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
            "not": {
              "enum": [
                "__proto__",
                "prototype",
                "constructor"
              ]
            }
          },
          "maxItems": 256,
          "uniqueItems": true
        },
        "nearbySourceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
            "not": {
              "enum": [
                "__proto__",
                "prototype",
                "constructor"
              ]
            }
          },
          "maxItems": 256,
          "uniqueItems": true
        },
        "signals": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
            "not": {
              "enum": [
                "__proto__",
                "prototype",
                "constructor"
              ]
            }
          },
          "maxItems": 256,
          "uniqueItems": true
        },
        "flags": {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
            "not": {
              "enum": [
                "__proto__",
                "prototype",
                "constructor"
              ]
            }
          },
          "additionalProperties": {
            "type": "boolean"
          }
        },
        "occupied": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
                "not": {
                  "enum": [
                    "__proto__",
                    "prototype",
                    "constructor"
                  ]
                }
              },
              "catalogId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
                "not": {
                  "enum": [
                    "__proto__",
                    "prototype",
                    "constructor"
                  ]
                }
              },
              "layerId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
                "not": {
                  "enum": [
                    "__proto__",
                    "prototype",
                    "constructor"
                  ]
                }
              },
              "x": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4095
              },
              "y": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4095
              },
              "properties": {
                "type": "object"
              }
            },
            "required": [
              "id",
              "catalogId",
              "layerId",
              "x",
              "y",
              "properties"
            ]
          },
          "maxItems": 12000
        }
      },
      "required": [
        "clock",
        "phase",
        "activeLayerIds",
        "activeSourceIds",
        "enteredSourceIds",
        "nearbySourceIds",
        "signals",
        "flags",
        "occupied"
      ]
    },
    "commands": {
      "type": "array",
      "items": {
        "$ref": "emission.schema.json"
      },
      "maxItems": 12000
    },
    "records": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
        "not": {
          "enum": [
            "__proto__",
            "prototype",
            "constructor"
          ]
        }
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "created": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000
          },
          "attempt": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000
          },
          "activated": {
            "type": "boolean"
          },
          "nextAt": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 1000000000000
              },
              {
                "type": "null"
              }
            ]
          },
          "done": {
            "type": "boolean"
          },
          "rules": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
              "not": {
                "enum": [
                  "__proto__",
                  "prototype",
                  "constructor"
                ]
              }
            },
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "created": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000000
                },
                "target": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 5000
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "sequence": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000000000
                }
              },
              "required": [
                "created",
                "target",
                "sequence"
              ]
            }
          }
        },
        "required": [
          "created",
          "attempt",
          "activated",
          "nextAt",
          "done",
          "rules"
        ]
      }
    },
    "reports": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "maxItems": 256
    },
    "checksum": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    }
  },
  "required": [
    "schema",
    "schemaVersion",
    "sceneFingerprint",
    "stateChecksum",
    "context",
    "commands",
    "records",
    "reports",
    "checksum"
  ]
}
