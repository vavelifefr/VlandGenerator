{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vland.invalid/schemas/transition.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
      "not": {
        "enum": [
          "__proto__",
          "prototype",
          "constructor"
        ]
      }
    },
    "kind": {
      "enum": [
        "teleport",
        "lift",
        "stairs"
      ]
    },
    "fromSourceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
      "not": {
        "enum": [
          "__proto__",
          "prototype",
          "constructor"
        ]
      }
    },
    "toSourceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
      "not": {
        "enum": [
          "__proto__",
          "prototype",
          "constructor"
        ]
      }
    },
    "bidirectional": {
      "type": "boolean"
    },
    "travelCost": {
      "type": "number",
      "minimum": 0,
      "maximum": 100000
    }
  },
  "required": [
    "id",
    "kind",
    "fromSourceId",
    "toSourceId",
    "bidirectional",
    "travelCost"
  ]
}
