{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vland.invalid/engine/schemas/region-state.schema.json",
  "title": "VlandGenerator region-state v1",
  "type": "object",
  "properties": {
    "schema": {
      "const": "vland.region-state"
    },
    "schemaVersion": {
      "const": 1
    },
    "planFingerprint": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8,
      "pattern": "^[0-9a-f]{8}$"
    },
    "originals": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 48,
        "pattern": "^(?!__proto__$|constructor$|prototype$)[a-zA-Z0-9_-]+$"
      },
      "additionalProperties": {
        "$ref": "bundle.schema.json"
      },
      "maxProperties": 12
    },
    "regions": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 48,
        "pattern": "^(?!__proto__$|constructor$|prototype$)[a-zA-Z0-9_-]+$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "dungeon": {
            "$ref": "bundle.schema.json"
          },
          "runtime": {
            "type": "object",
            "properties": {
              "openedGateIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 96
                },
                "maxItems": 512,
                "minItems": 0
              },
              "brokenFeatureIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 96
                },
                "maxItems": 250000,
                "minItems": 0
              },
              "blockedCells": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 4095
                    },
                    "y": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 4095
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "x",
                    "y"
                  ]
                },
                "maxItems": 250000,
                "minItems": 0
              },
              "content": {
                "type": "object"
              },
              "environment": {
                "type": "object"
              }
            },
            "additionalProperties": false,
            "required": [
              "openedGateIds",
              "brokenFeatureIds",
              "blockedCells",
              "content"
            ]
          },
          "contentRevision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 256
          }
        },
        "additionalProperties": false,
        "required": [
          "dungeon",
          "runtime",
          "contentRevision"
        ]
      },
      "maxProperties": 12
    },
    "visited": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 48,
        "pattern": "^(?!__proto__$|constructor$|prototype$)[a-zA-Z0-9_-]+$"
      },
      "maxItems": 12,
      "minItems": 0,
      "uniqueItems": true
    },
    "journal": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "enum": [
              "visit",
              "transaction",
              "regenerate",
              "replace"
            ]
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96
          },
          "regionId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 48,
            "pattern": "^(?!__proto__$|constructor$|prototype$)[a-zA-Z0-9_-]+$"
          },
          "sequence": {
            "type": "integer",
            "minimum": 1,
            "maximum": 256
          },
          "operations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "enum": [
                    "add-wall",
                    "remove-wall",
                    "open-gate",
                    "close-gate",
                    "break-feature",
                    "set-zone",
                    "power"
                  ]
                },
                "position": {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 4095
                    },
                    "y": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 4095
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "x",
                    "y"
                  ]
                },
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 96
                },
                "on": {
                  "type": "boolean"
                },
                "cleared": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false,
              "required": [
                "type"
              ]
            },
            "maxItems": 64,
            "minItems": 1
          },
          "actors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 96
                },
                "position": {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 4095
                    },
                    "y": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 4095
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "x",
                    "y"
                  ]
                },
                "profile": {
                  "$ref": "movement-profile.schema.json"
                },
                "safetyTarget": {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 4095
                    },
                    "y": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 4095
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "x",
                    "y"
                  ]
                }
              },
              "additionalProperties": false,
              "required": [
                "id",
                "position",
                "profile"
              ]
            },
            "maxItems": 256,
            "minItems": 0
          },
          "transactionFingerprint": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8,
            "pattern": "^[0-9a-f]{8}$"
          },
          "before": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8,
            "pattern": "^[0-9a-f]{8}$"
          },
          "after": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8,
            "pattern": "^[0-9a-f]{8}$"
          },
          "dungeon": {
            "$ref": "bundle.schema.json"
          }
        },
        "additionalProperties": false,
        "required": [
          "type",
          "id",
          "regionId",
          "sequence"
        ]
      },
      "maxItems": 256,
      "minItems": 0
    },
    "fingerprint": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8,
      "pattern": "^[0-9a-f]{8}$"
    }
  },
  "additionalProperties": true,
  "required": [
    "schema",
    "schemaVersion",
    "planFingerprint",
    "originals",
    "regions",
    "visited",
    "journal",
    "fingerprint"
  ]
}
