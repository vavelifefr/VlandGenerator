{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vland.invalid/engine/schemas/movement-profile.schema.json",
  "title": "VlandGenerator movement-profile v1",
  "oneOf": [
    {
      "enum": [
        "walker",
        "large",
        "flyer",
        "swimmer"
      ]
    },
    {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "mode": {
          "enum": [
            "ground",
            "flying",
            "swimming"
          ]
        },
        "bodyHeight": {
          "type": "number",
          "minimum": 0,
          "maximum": 8,
          "exclusiveMinimum": 0
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "maxItems": 64,
          "minItems": 0
        },
        "maxStep": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "maxWaterDepth": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    }
  ]
}
